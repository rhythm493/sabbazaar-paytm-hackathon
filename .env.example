# Copy to .env for local development. Never commit real credentials.

APP_ENV=development

# Model layer (ADR 0007). Default: free Google AI Studio key with a vision-capable Gemini model.
# Other options: MODEL_PROVIDER=openai|anthropic, or OpenAI-compatible endpoints via MODEL_BASE_URL
# (e.g. MODEL_PROVIDER=openai, MODEL_BASE_URL=https://api.goedelmachines.com/v1).
MODEL_ENABLED=true
MODEL_PROVIDER=google_genai
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

SARVAM_API_KEY=
SPEECH_ENABLED=true

# Bill-intake channels: "shopify" (real operations; blocked honestly until connected) or "fake" (simulated).
CHANNEL_MODE=shopify

# Shopify credentials (shared by the publish endpoints and bill-intake operations).
SHOPIFY_SHOP_DOMAIN=
# Preferred for Dev Dashboard custom apps: exchange client credentials for a short-lived token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional static/legacy token. Leave blank when using client credentials.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Required for creating stocked products and inventory sync (numeric id or gid).
SHOPIFY_LOCATION_ID=
# Ridam's publish endpoints: shopify | fake
SHOPIFY_CONNECTOR=shopify
WEB_ORIGINS=http://localhost:5173
RUN_LIVE_SHOPIFY_SMOKE=0

# SQLAlchemy/Alembic database (Ridam). Bill intake still uses in-memory repositories until mapped.
DATABASE_URL=sqlite:///./sabbazaar.db
