# Copy to .env for local development after application tooling is initialized.
# Never commit real credentials.

APP_ENV=development
DATABASE_URL=sqlite:///./sabbazaar.db
MODEL_BASE_URL=https://api.goedelmachines.com/v1
MODEL_NAME=
MODEL_API_KEY=
SARVAM_API_KEY=
SHOPIFY_SHOP_DOMAIN=
# Preferred for Dev Dashboard custom apps: exchange client credentials for a short-lived token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional static/legacy token. Leave blank when using client credentials.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_LOCATION_ID=
SHOPIFY_CONNECTOR=shopify
WEB_ORIGINS=http://localhost:5173
MODEL_ENABLED=true
SPEECH_ENABLED=true
RUN_LIVE_SHOPIFY_SMOKE=0
